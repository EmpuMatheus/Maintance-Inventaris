# ============================================================
# OFFICE INVENTORY MAINTENANCE SYSTEM
# Environment Variables Example
# ============================================================
#
# IMPORTANT:
# 1. Never place real production secrets in this file.
# 2. Never commit your real .env file.
# 3. Copy this file and configure values for your environment.
#
# Example:
#   .env.example  →  .env
#
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
# Runtime mode: development | production | test
# In production the API validates required secrets on startup and fails fast,
# uses rotating file logs, and enables the scheduled backup worker.
NODE_ENV=development
APP_ENV=development
APP_NAME=Office Inventory Maintenance System
APP_VERSION=1.0.0
# Public base URL of the deployment, e.g. https://inventory.example.com
BASE_URL=

# ============================================================
# BACKEND SERVER
# ============================================================
PORT=3000
API_PREFIX=/api/v1

# ============================================================
# FRONTEND
# ============================================================
VITE_APP_NAME=Office Inventory Maintenance System
# Relative path -> requests are proxied by Vite to the API during development,
# so the app works via localhost / 127.0.0.1 / LAN IP without changes.
# For production, set an absolute URL, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1
# API server the Vite dev proxy forwards /api and /uploads to.
VITE_API_PROXY_TARGET=http://localhost:3000

# ============================================================
# DATABASE
# ============================================================
# Format:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Example only:
#   postgresql://postgres:password@localhost:5432/office_inventory
# Replace with your own local credentials.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/office_inventory
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

# ============================================================
# AUTHENTICATION
# ============================================================
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_HASH_ALGORITHM=argon2id

# ============================================================
# CORS
# ============================================================
# Comma-separated explicit allowlist of origins.
# In development, localhost, loopback and any private LAN IP are also allowed
# automatically, so no per-IP entry is needed here.
# In production only this list is allowed (no wildcard).
# Example: http://localhost:5173,https://app.example.com
CORS_ORIGIN=http://localhost:5173

# ============================================================
# RATE LIMIT
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ============================================================
# REQUEST BODY
# ============================================================
REQUEST_BODY_LIMIT=2mb

# ============================================================
# FILE STORAGE
# ============================================================
STORAGE_DRIVER=local
STORAGE_PATH=./storage
UPLOAD_IMAGE_MAX_SIZE=5242880
UPLOAD_DOCUMENT_MAX_SIZE=10485760
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_ALLOWED_DOCUMENT_TYPES=application/pdf

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
# Production writes daily rotating logs to this directory (relative to the
# storage root):
#   app-YYYY-MM-DD.log, error-YYYY-MM-DD.log, access-YYYY-MM-DD.log
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# ============================================================
# HTTPS (direct TLS; optional when a reverse proxy terminates TLS)
# ============================================================
# true|false — serve TLS directly. Leave false when behind Nginx/Apache/IIS.
HTTPS_ENABLED=false
HTTPS_KEY=
HTTPS_CERT=
# Mark cookies Secure when HTTPS is enabled (tokens are stored client-side).
COOKIE_SECURE=
# Express trust proxy: false | true | hop count (e.g. 1) | loopback
# Set to 1 when running behind a reverse proxy so X-Forwarded-* is honoured.
TRUST_PROXY=false

# ============================================================
# BACKUPS
# ============================================================
# Backup root directory (relative to the storage root). Database backups go to
# <BACKUP_DIR>/database, upload backups to <BACKUP_DIR>/uploads.
BACKUP_DIR=backups
# Keep backups for N days, then prune automatically.
BACKUP_DATABASE_RETENTION_DAYS=14
BACKUP_UPLOADS_RETENTION_DAYS=14
# Scheduled database backup interval in minutes. 0 disables (default).
# Production example: 1440 = daily.
BACKUP_INTERVAL_MINUTES=0
# Absolute path to pg_dump when it is not on PATH, e.g. C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP_PATH=

# ============================================================
# PRODUCTION ADMIN (created by `npm run db:seed:prod`)
# ============================================================
PROD_ADMIN_USERNAME=admin
# REQUIRED in production (startup fails fast if empty). Strong initial password;
# the admin is forced to change it after first login.
PROD_ADMIN_PASSWORD=
PROD_ADMIN_NAME=Production Administrator

# ============================================================
# ANALYTICS (health score, failure detection, replacement)
# ============================================================
# How often the background job recomputes asset health scores (minutes).
ANALYTICS_RECALC_INTERVAL_MINUTES=1440
# Health score factor weights (normalized; they need not sum to 100).
ANALYTICS_WEIGHT_AGE=20
ANALYTICS_WEIGHT_MAINTENANCE=20
ANALYTICS_WEIGHT_FAILURE_RATIO=15
ANALYTICS_WEIGHT_CONDITION=20
ANALYTICS_WEIGHT_DOWNTIME=10
ANALYTICS_WEIGHT_TICKETS=10
ANALYTICS_WEIGHT_CRITICAL_EVENTS=5
# Expected asset lifespan used by the age factor and replacement logic.
ANALYTICS_EXPECTED_LIFESPAN_YEARS=7
# Repeated-failure detection thresholds.
ANALYTICS_FAILURE_THRESHOLD=3
ANALYTICS_TICKET_THRESHOLD=3
ANALYTICS_FAILURE_WINDOW_DAYS=90
# Replacement recommendation health thresholds and cost ratio.
ANALYTICS_REPLACE_IMMEDIATE_HEALTH=35
ANALYTICS_REPLACE_SOON_HEALTH=50
ANALYTICS_REPAIR_HEALTH=65
ANALYTICS_REPLACE_COST_RATIO=0.5

# ============================================================
# PAGINATION
# ============================================================
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# ============================================================
# MAINTENANCE
# ============================================================
DEFAULT_MAINTENANCE_REMINDER_DAYS=7
# How often the preventive-maintenance background processor runs (minutes).
SCHEDULE_PROCESS_INTERVAL_MINUTES=60

# ============================================================
# QR
# ============================================================
QR_VALUE_TYPE=asset_code

# ============================================================
# TIMEZONE & LOCALE
# ============================================================
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id-ID

# ============================================================
# DEVELOPMENT
# ============================================================
ENABLE_API_DOCS=true
ENABLE_DEVELOPMENT_LOGS=true

# ============================================================
# SECURITY
# ============================================================
# Never expose server-side variables through VITE_* variables.
# VITE_* variables are bundled into frontend code and must be
# treated as PUBLIC configuration.
# ============================================================
