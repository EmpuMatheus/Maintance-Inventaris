# Nginx example — reverse proxy for the Office Inventory system.
# Terminates TLS, serves the built SPA, and forwards API/uploads to Node.

server {
    listen 80;
    server_name inventory.example.com;
    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name inventory.example.com;

    ssl_certificate     /etc/letsencrypt/live/inventory.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/inventory.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # ---- SPA (apps/web/dist) ----
    root /opt/office-inventory/apps/web/dist;
    index index.html;

    # React Router: fall back to index.html for client-side routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache hashed static assets aggressively
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ---- API proxy ----
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 120s;
        client_max_body_size 20m;
    }

    # ---- Uploaded files (storage/uploads) ----
    location /uploads/ {
        alias /opt/office-inventory/storage/uploads/;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Optional: block hidden files
    location ~ /\. { deny all; }
}
